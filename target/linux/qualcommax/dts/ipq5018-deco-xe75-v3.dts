/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link Deco XE75 v3";
	compatible = "tplink,deco-xe75-v3", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " coherent_pool=2M";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_red: led-red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
		};

		led_green: led-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_blue: led-blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 13 GPIO_ACTIVE_LOW>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&q6_region {
	reg = <0x0 0x4b000000 0x0 0x4d00000>;
};

&q6v5_wcss {
	status = "okay";
};

&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "TP-Link-Deco-XE75-v3";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

/* The first external radio is 5 GHz, served by firmware user domain 3. */
&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd3>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
	qcom,ath11k-calibration-variant = "TP-Link-Deco-XE75-v3-5G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d200000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

/* The second external radio is 6 GHz, served by firmware user domain 2. */
&wifi2 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "TP-Link-Deco-XE75-v3-6G";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4e500000>;
	qcom,m3-dump-addr = <0x4f200000>;
};

/* Factory provisioning only. No environment or writeable flash is exposed. */
&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@4c0000 {
				label = "0:ART";
				reg = <0x4c0000 0x100000>;
				read-only;
			};

			partition@640000 {
				label = "stock-rootfs";
				reg = <0x640000 0x2a00000>;
				read-only;
			};

			partition@3040000 {
				label = "stock-rootfs_1";
				reg = <0x3040000 0x2a00000>;
				read-only;
			};

			partition@5ac0000 {
				label = "factory_data";
				reg = <0x5ac0000 0x900000>;
				read-only;
			};
		};
	};
};

/*
 * mdio0 must remain enabled even though gmac0 and the internal GE PHY are
 * unused. On IPQ5018 its reset path also gates the MDC/MDIO path used by mdio1.
 */
&mdio0 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac1 {
	/*
	 * The RTL8367D has no matching DSA driver yet. Do not reset it:
	 * RAM-boot Ethernet experiments depend on U-Boot initialization.
	 * This fixed link describes only the SoC-to-switch connection.
	 */
	status = "okay";
	label = "lan";
	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
};

&tlmm {
	button_pins: button-state {
		pins = "gpio12";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-state {
		pins = "gpio13", "gpio22", "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	mdio1_pins: mdio1-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
