Subject: ath11k: bound receive-head allocation

Allocate receive heads independently to avoid retaining large fragment
pages when only a few receive buffers remain active.

--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -340,6 +340,21 @@
 	return -ETIMEDOUT;
 }
 
+/* Receive buffers can outlive other fragments from the same large page.
+ * Allocate heads individually so a sparse ring cannot pin large fragment
+ * pages. Preserve the RX allocation flags and headroom of dev_alloc_skb().
+ */
+static struct sk_buff *ath11k_dp_rx_alloc_bounded_skb(unsigned int len)
+{
+	struct sk_buff *skb;
+
+	skb = __alloc_skb(len + NET_SKB_PAD, GFP_ATOMIC, SKB_ALLOC_RX,
+			  NUMA_NO_NODE);
+	if (skb)
+		skb_reserve(skb, NET_SKB_PAD);
+	return skb;
+}
+
 /* Returns number of Rx buffers replenished */
 int ath11k_dp_rxbufs_replenish(struct ath11k_base *ab, int mac_id,
 			       struct dp_rxdma_ring *rx_ring,
@@ -371,8 +386,8 @@
 	num_remain = req_entries;
 
 	while (num_remain > 0) {
-		skb = dev_alloc_skb(DP_RX_BUFFER_SIZE +
-				    DP_RX_BUFFER_ALIGN_SIZE);
+		skb = ath11k_dp_rx_alloc_bounded_skb(DP_RX_BUFFER_SIZE +
+					       DP_RX_BUFFER_ALIGN_SIZE);
 		if (!skb)
 			break;
 
@@ -2867,8 +2882,8 @@
 	struct sk_buff *skb;
 	dma_addr_t paddr;
 
-	skb = dev_alloc_skb(DP_RX_BUFFER_SIZE +
-			    DP_RX_BUFFER_ALIGN_SIZE);
+	skb = ath11k_dp_rx_alloc_bounded_skb(DP_RX_BUFFER_SIZE +
+				       DP_RX_BUFFER_ALIGN_SIZE);
 
 	if (!skb)
 		goto fail_alloc_skb;
